<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/today_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️"
                    android:textSize="23sp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:shadowColor="#cc000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="4"/>

                <TextView
                    android:id="@+id/today_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18°"
                    android:textColor="#ffaa00"
                    android:textSize="56sp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:shadowColor="#e6000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="7"/>
            </LinearLayout>

            <TextView
                android:id="@+id/today_minmax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21°/15°"
                android:textColor="#f2f5f8"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/widget_pill_green"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="72dp"
            android:background="#22888888"
            android:text=""/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tomorrow_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️"
                    android:textSize="23sp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:shadowColor="#cc000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="4"/>

                <TextView
                    android:id="@+id/tomorrow_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18°"
                    android:textColor="#c97fff"
                    android:textSize="56sp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:shadowColor="#e6000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="7"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tomorrow_minmax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21°/15°"
                android:textColor="#f2f5f8"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/widget_pill_pink"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

    <TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/today_desc" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_desc" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/today_icon_bg" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_icon_bg" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/today_rain" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/today_wind" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_rain" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_wind" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</LinearLayout>
