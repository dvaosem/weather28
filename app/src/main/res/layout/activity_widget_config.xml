<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WEATHER28 WIDGET"
            android:textColor="#c9a27a"
            android:textSize="18sp"
            android:fontFamily="sans-serif-condensed"
            android:textAllCaps="true"
            android:letterSpacing="0.2"
            android:layout_marginBottom="24dp"/>

        <!-- City search -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_city"
            android:textColor="#8c8c8c"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/cfg_search_hint"
                android:textColor="#f5f5f5"
                android:textColorHint="#8c8c8c"
                android:background="@drawable/config_input_bg"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cfg_search"
                android:background="@drawable/config_btn_bg"
                android:textColor="#000000"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:indeterminateTint="#c9a27a"/>

        <!-- GPS button - compact, left aligned -->
        <Button
            android:id="@+id/btn_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cfg_my_location"
            android:background="@drawable/config_input_bg"
            android:textColor="#8c8c8c"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_marginTop="8dp"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/tv_search_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Bratislava"
            android:textColor="#c9a27a"
            android:textSize="11sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <!-- Units -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_units"
            android:textColor="#8c8c8c"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rg_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_celsius"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="°C Celsius"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_fahrenheit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="°F Fahrenheit"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>
        </RadioGroup>

        <!-- Style -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_style"
            android:textColor="#8c8c8c"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rg_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/rb_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cfg_style_dark"
                android:textColor="#f5f5f5"
                android:textSize="14sp"
                android:buttonTint="#c9a27a"
                android:padding="8dp"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cfg_style_light"
                android:textColor="#f5f5f5"
                android:textSize="14sp"
                android:buttonTint="#c9a27a"
                android:padding="8dp"/>

            <RadioButton
                android:id="@+id/rb_transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cfg_style_none"
                android:textColor="#f5f5f5"
                android:textSize="14sp"
                android:buttonTint="#c9a27a"
                android:padding="8dp"/>
        </RadioGroup>

        <!-- Opacity (len pre tmavý/svetlý) -->
        <TextView
            android:id="@+id/tv_opacity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_opacity"
            android:textColor="#8c8c8c"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/sb_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:progress="4"
            android:progressTint="#c9a27a"
            android:thumbTint="#c9a27a"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_opacity_val"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textColor="#8c8c8c"
            android:textSize="11sp"
            android:gravity="end"
            android:layout_marginBottom="24dp"/>

        <!-- Intenzita liquid glass (len pre priehľadný štýl) -->
        <TextView
            android:id="@+id/tv_glass_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_glass"
            android:textColor="#8c8c8c"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp"
            android:visibility="gone"/>

        <SeekBar
            android:id="@+id/sb_glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:progress="1"
            android:progressTint="#c9a27a"
            android:thumbTint="#c9a27a"
            android:layout_marginBottom="4dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_glass_val"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="20%"
            android:textColor="#8c8c8c"
            android:textSize="11sp"
            android:gravity="end"
            android:layout_marginBottom="24dp"
            android:visibility="gone"/>




        <!-- Zobrazenie -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_display"
            android:textColor="#8c8c8c"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp"/>

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_mode_duo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cfg_mode_duo"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_mode_single"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cfg_mode_single"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>
        </RadioGroup>

        <!-- Text forecast line -->
        <CheckBox
            android:id="@+id/cb_show_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_show_text"
            android:textColor="#f5f5f5"
            android:textSize="14sp"
            android:buttonTint="#c9a27a"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_font_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_text_font"
            android:textColor="#8c8c8c"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rg_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_font_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cfg_font_default"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_font_inter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inter"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>

            <RadioButton
                android:id="@+id/rb_font_bebas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bebas Neue"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>

            <RadioButton
                android:id="@+id/rb_font_condensed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Condensed"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>

            <RadioButton
                android:id="@+id/rb_font_serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Serif"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>

            <RadioButton
                android:id="@+id/rb_font_mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mono"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>
        </RadioGroup>

        <!-- Interval -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_interval"
            android:textColor="#8c8c8c"
            android:textSize="9sp"
            android:textAllCaps="true"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp"/>

        <RadioGroup
            android:id="@+id/rg_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_15min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15 min"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>

            <RadioButton
                android:id="@+id/rb_30min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30 min"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rb_60min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="60 min"
                android:textColor="#f5f5f5"
                android:buttonTint="#c9a27a"/>
        </RadioGroup>

        <!-- Save button -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/cfg_add"
            android:background="@drawable/config_btn_bg"
            android:textColor="#000000"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>
