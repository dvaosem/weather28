<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg_transparent"
    android:padding="2dp">

    <TextView
        android:id="@+id/today_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⛅"
        android:textSize="18sp"
        android:includeFontPadding="false"
        android:gravity="center"/>

    <TextView
        android:id="@+id/today_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="22°"
        android:textColor="#ffaa00"
        android:textSize="26sp"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.85"
        android:gravity="center"/>

    <TextView
        android:id="@+id/today_minmax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25°/11°"
        android:textColor="#00e5a0"
        android:textSize="9sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:layout_marginTop="1dp"
        android:gravity="center"/>

    <TextView android:id="@+id/widget_refresh"    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/today_desc"        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/today_rain"        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/today_wind"        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_temp"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_icon"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_desc"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_minmax"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_rain"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tomorrow_wind"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout>
