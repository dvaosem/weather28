<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg_transparent">

    <ImageView
            android:id="@+id/today_icon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.2"
            android:src="@drawable/wi_cloudy"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"/>

    <TextView
            android:id="@+id/today_temp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:text="--°"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/bebas_neue"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:gravity="center"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="60sp"
            android:autoSizeStepGranularity="1sp"
            android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="6"/>

    <TextView
            android:id="@+id/today_minmax"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"
            android:text=""
            android:textColor="#FFFFFF"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:gravity="center"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="4"/>

</LinearLayout>
