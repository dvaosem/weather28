<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg_dark">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="horizontal">

            <ImageView
                    android:id="@+id/today_icon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:src="@drawable/wi_cloudy"
                    android:scaleType="fitEnd"
                    android:adjustViewBounds="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:paddingEnd="3dp"/>

            <TextView
                    android:id="@+id/today_temp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:text="--°"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/bebas_neue"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:gravity="center_vertical|start"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="64sp"
                    android:autoSizeStepGranularity="1sp"/>
        </LinearLayout>

        <TextView
                android:id="@+id/today_minmax"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.1"
                android:text=""
                android:textColor="#FFFFFF"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#2EFFFFFF"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="horizontal">

            <ImageView
                    android:id="@+id/tomorrow_icon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:src="@drawable/wi_cloudy"
                    android:scaleType="fitEnd"
                    android:adjustViewBounds="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:paddingEnd="3dp"/>

            <TextView
                    android:id="@+id/tomorrow_temp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:text="--°"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/bebas_neue"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:gravity="center_vertical|start"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="64sp"
                    android:autoSizeStepGranularity="1sp"/>
        </LinearLayout>

        <TextView
                android:id="@+id/tomorrow_minmax"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.1"
                android:text=""
                android:textColor="#FFFFFF"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:gravity="center"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>

</LinearLayout>
